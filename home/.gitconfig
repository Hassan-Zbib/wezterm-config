[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[core]
	editor = \"C:\\Users\\hassa\\AppData\\Local\\Programs\\Microsoft VS Code\\bin\\code\" --wait
	autocrlf = false
	eol = lf
	ignorecase = false
	longpaths = true
[color]
	ui = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[user]
	name = Hassan Zbib
	email = hassan.zbib01@gmail.com
[credential "https://github.com"]
	helper = 
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential
[delta]
	# Read by delta itself, wherever it is invoked from — lazygit's diff
	# panes pick these up. Inert for plain `git diff` unless core.pager
	# is set to delta (deliberately not set; add it if you want delta
	# for git on the command line too).
	syntax-theme = Catppuccin Macchiato
	line-numbers = true
